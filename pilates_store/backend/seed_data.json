  "faqs": [
    {
      "q": "When will my pre-booked order arrive?",
      "a": "Every piece is made to order and delivered within 3–4 weeks of booking, to the address you choose at checkout. We message you when it is built, dispatched and out for delivery."
    },
    {
      "q": "How does reserving with 10% work?",
      "a": "Pay 10% today to lock in your order and price. The balance is due before dispatch. You can also pay the full amount when you pre-book."
    },
    {
      "q": "Can I cancel or change a pre-booking?",
      "a": "Yes. Change the delivery address or cancel any time before dispatch for a full refund of everything you have paid."
    },
    {
      "q": "Is assembly included?",
      "a": "Large equipment arrives 90% assembled with tools and a step-by-step guide. Most customers finish setup in under 30 minutes."
    },
    {
      "q": "What does the warranty cover?",
      "a": "Frames are covered for 5 years. Springs, ropes and upholstery are covered for 2 years against manufacturing defects."
    }
  ]
